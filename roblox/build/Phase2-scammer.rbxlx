      <Item class="LocalScript" referent="8">
        <Properties>
          <string name="Name">MissionController</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

local MissionContent = require(ReplicatedStorage:WaitForChild("MissionContent") :: ModuleScript)
local remotesFolder = ReplicatedStorage:WaitForChild("MissionRemotes")
local requestActionRemote = remotesFolder:WaitForChild("RequestAction") :: RemoteEvent
local missionUpdateRemote = remotesFolder:WaitForChild("MissionUpdate") :: RemoteEvent

-- Create custom ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MissionGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = playerGui

-- Simulated Private Chat Panel per D-14, D-18
local chatFrame = Instance.new("Frame")
chatFrame.Name = "SimulatedChatFrame"
chatFrame.Size = UDim2.fromScale(0.32, 0.48)
chatFrame.Position = UDim2.fromScale(0.04, 0.95)
chatFrame.AnchorPoint = Vector2.new(0, 1)
chatFrame.BackgroundColor3 = Color3.fromRGB(15, 22, 34)
chatFrame.BackgroundTransparency = 0.05
chatFrame.BorderSizePixel = 0
chatFrame.Visible = false
chatFrame.Parent = screenGui

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MaxSize = Vector2.new(440, 420)
sizeConstraint.MinSize = Vector2.new(280, 260)
sizeConstraint.Parent = chatFrame

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 12)
frameCorner.Parent = chatFrame

local frameStroke = Instance.new("UIStroke")
frameStroke.Color = Color3.fromRGB(0, 160, 240)
frameStroke.Thickness = 2
frameStroke.Parent = chatFrame

-- Header Bar (38px)
local headerBar = Instance.new("Frame")
headerBar.Name = "HeaderBar"
headerBar.Size = UDim2.new(1, 0, 0, 38)
headerBar.Position = UDim2.fromOffset(0, 0)
headerBar.BackgroundColor3 = Color3.fromRGB(22, 32, 48)
headerBar.BorderSizePixel = 0
headerBar.Parent = chatFrame

local headerCorner = Instance.new("UICorner")
headerCorner.CornerRadius = UDim.new(0, 12)
headerCorner.Parent = headerBar

local titleLabel = Instance.new("TextLabel")
titleLabel.Name = "TitleLabel"
titleLabel.Size = UDim2.new(1, -70, 0, 20)
titleLabel.Position = UDim2.fromOffset(12, 4)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.FredokaOne
titleLabel.TextSize = 14
titleLabel.TextColor3 = Color3.fromRGB(255, 220, 50)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Text = "MatiBuilds"
titleLabel.Parent = headerBar

local subTitleLabel = Instance.new("TextLabel")
subTitleLabel.Name = "SubTitleLabel"
subTitleLabel.Size = UDim2.new(1, -70, 0, 14)
subTitleLabel.Position = UDim2.fromOffset(12, 22)
subTitleLabel.BackgroundTransparency = 1
subTitleLabel.Font = Enum.Font.Gotham
subTitleLabel.TextSize = 10
subTitleLabel.TextColor3 = Color3.fromRGB(130, 200, 255)
subTitleLabel.TextXAlignment = Enum.TextXAlignment.Left
subTitleLabel.Text = "Wiadomość prywatna (symulacja)"
subTitleLabel.Parent = headerBar

local closeBtn = Instance.new("TextButton")
closeBtn.Name = "CloseButton"
closeBtn.Size = UDim2.fromOffset(28, 28)
closeBtn.Position = UDim2.new(1, -34, 0, 5)
closeBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
closeBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 14
closeBtn.Text = "✕"
closeBtn.Parent = headerBar

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeBtn

closeBtn.Activated:Connect(function()
	requestActionRemote:FireServer("close")
end)

-- Messages History (ScrollingFrame)
local messageScroll = Instance.new("ScrollingFrame")
messageScroll.Name = "MessageScroll"
messageScroll.Size = UDim2.new(1, -16, 1, -145)
messageScroll.Position = UDim2.fromOffset(8, 44)
messageScroll.BackgroundTransparency = 1
messageScroll.BorderSizePixel = 0
messageScroll.ScrollBarThickness = 4
messageScroll.ScrollBarImageColor3 = Color3.fromRGB(60, 100, 150)
messageScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
messageScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
messageScroll.Parent = chatFrame

local messageLayout = Instance.new("UIListLayout")
messageLayout.FillDirection = Enum.FillDirection.Vertical
messageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
messageLayout.VerticalAlignment = Enum.VerticalAlignment.Top
messageLayout.Padding = UDim.new(0, 8)
messageLayout.Parent = messageScroll

-- Choices Container at bottom
local choicesContainer = Instance.new("Frame")
choicesContainer.Name = "ChoicesContainer"
choicesContainer.Size = UDim2.new(1, -16, 0, 92)
choicesContainer.Position = UDim2.new(0, 8, 1, -96)
choicesContainer.BackgroundTransparency = 1
choicesContainer.Parent = chatFrame

local choicesLayout = Instance.new("UIListLayout")
choicesLayout.FillDirection = Enum.FillDirection.Vertical
choicesLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
choicesLayout.VerticalAlignment = Enum.VerticalAlignment.Center
choicesLayout.Padding = UDim.new(0, 6)
choicesLayout.Parent = choicesContainer

local function clearContainer(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UICorner") then
			child:Destroy()
		end
	end
end

local function renderMessageBubble(msg: MissionContent.ChatMessage)
	local isPlayer = (msg.sender == "Ty")
	local isSystem = (msg.sender == "System")

	local bubbleContainer = Instance.new("Frame")
	bubbleContainer.Size = UDim2.fromScale(1, 0)
	bubbleContainer.AutomaticSize = Enum.AutomaticSize.Y
	bubbleContainer.BackgroundTransparency = 1

	local bubble = Instance.new("Frame")
	bubble.AutomaticSize = Enum.AutomaticSize.XY
	bubble.BorderSizePixel = 0

	local bubbleCorner = Instance.new("UICorner")
	bubbleCorner.CornerRadius = UDim.new(0, 8)
	bubbleCorner.Parent = bubble

	local textLabel = Instance.new("TextLabel")
	textLabel.Font = Enum.Font.GothamMedium
	textLabel.TextSize = 12
	textLabel.TextWrapped = true
	textLabel.AutomaticSize = Enum.AutomaticSize.XY
	textLabel.BackgroundTransparency = 1

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = textLabel

	if isSystem then
		bubble.BackgroundColor3 = Color3.fromRGB(35, 45, 65)
		bubble.AnchorPoint = Vector2.new(0.5, 0)
		bubble.Position = UDim2.fromScale(0.5, 0)
		textLabel.TextColor3 = Color3.fromRGB(240, 220, 100)
		textLabel.Text = msg.text
	elseif isPlayer then
		bubble.BackgroundColor3 = Color3.fromRGB(36, 110, 185) -- Player blue
		bubble.AnchorPoint = Vector2.new(1, 0)
		bubble.Position = UDim2.fromScale(1, 0)
		textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		textLabel.Text = msg.text
	else
		bubble.BackgroundColor3 = Color3.fromRGB(28, 38, 56) -- NPC dark slate
		bubble.AnchorPoint = Vector2.new(0, 0)
		bubble.Position = UDim2.fromOffset(0, 0)
		textLabel.TextColor3 = Color3.fromRGB(230, 235, 245)
		textLabel.Text = msg.text
	end

	textLabel.Parent = bubble
	bubble.Parent = bubbleContainer
	bubbleContainer.Parent = messageScroll
end

local function createChoiceButton(label: string, color: Color3, callback: () -> ()): TextButton
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 40)
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.FredokaOne
	btn.TextSize = 13
	btn.TextWrapped = true
	btn.Text = label
	btn.AutoButtonColor = true

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = btn

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(255, 255, 255)
	btnStroke.Thickness = 1
	btnStroke.Transparency = 0.7
	btnStroke.Parent = btn

	btn.Activated:Connect(callback)
	btn.Parent = choicesContainer
	return btn
end

local function renderSnapshot(snapshot: MissionContent.MissionSnapshot)
	if snapshot.status == "start" or snapshot.status == "closed" or snapshot.activeConversation == "none" then
		chatFrame.Visible = false
		return
	end

	chatFrame.Visible = true
	titleLabel.Text = snapshot.title or "MatiBuilds"

	-- Clear and rebuild message history
	clearContainer(messageScroll)
	local messages = if snapshot.activeConversation == "scamerino"
		then (snapshot.histories and snapshot.histories.scamerino or {})
		else (snapshot.histories and snapshot.histories.mati or {})

	for _, msg in ipairs(messages) do
		renderMessageBubble(msg)
	end

	-- Auto scroll to bottom
	task.defer(function()
		messageScroll.CanvasPosition = Vector2.new(0, 99999)
	end)

	-- Render choices
	clearContainer(choicesContainer)

	if snapshot.status == "decision" then
		for _, choice in ipairs(snapshot.choices) do
			if choice.enabled then
				-- Neutral slate-blue for both choices per D-14
				createChoiceButton(choice.label, Color3.fromRGB(36, 82, 138), function()
					requestActionRemote:FireServer(choice.id)
				end)
			end
		end
	elseif snapshot.status == "ending_good" or snapshot.status == "ending_bad" then
		createChoiceButton("Zagraj ponownie", Color3.fromRGB(52, 152, 219), function()
			requestActionRemote:FireServer("replay")
		end)
	end
end

missionUpdateRemote.OnClientEvent:Connect(function(data: any)
	if typeof(data) == "table" and data.revision ~= nil then
		renderSnapshot(data :: MissionContent.MissionSnapshot)
	elseif typeof(data) == "string" then
		-- Fallback compatibility for simple stage strings
		if data == "closed" or data == "start" then
			chatFrame.Visible = false
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="9">
        <Properties>
          <string name="Name">ScamerinoDialogueController</string>
          <string name="Source"><![CDATA[--!strict
--[=[
    ScamerinoDialogueController
    Obsługa okna dialogowego Scamerino Alertinio zgodnie z wytycznymi Roblox UX/UI:
    - Lower-Third layout (dolna 1/3 ekranu, nie zasłania postaci gracza i NPC)
    - Responsywne kotwiczenie: AnchorPoint = (0.5, 1), Position = (0.5, 0, 1, -20)
    - Ograniczenie rozmiaru (UISizeConstraint): max 840x240px
    - Touch Targets: min 44px wysokości na przyciskach dla urządzeń dotykowych
    - Płynne animacje wysuwania TweenService
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
local dialogueEvent = ReplicatedStorage:WaitForChild("ScamerinoDialogueEvent") :: RemoteEvent

-- Utwórz lub pobierz ScreenGui
local screenGui = playerGui:FindFirstChild("ScamerinoDialogueGui") :: ScreenGui?
if not screenGui then
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ScamerinoDialogueGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = playerGui
else
	-- Usuń ewentualne stare elementy interfejsu
	local oldMain = screenGui:FindFirstChild("MainFrame")
	if oldMain then
		oldMain:Destroy()
	end
end

-- Główny kontener dialogowy (Lower-Third Bar)
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.fromScale(0.92, 0.30)
mainFrame.Position = UDim2.fromScale(0.5, 1.4) -- Pozycja początkowa (ukryta pod dolną krawędzią)
mainFrame.AnchorPoint = Vector2.new(0.5, 1)
mainFrame.BackgroundColor3 = Color3.fromRGB(10, 20, 42)
mainFrame.BackgroundTransparency = 0.06
mainFrame.BorderSizePixel = 0
mainFrame.Visible = false
mainFrame.Parent = screenGui

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MaxSize = Vector2.new(840, 240)
sizeConstraint.MinSize = Vector2.new(340, 180)
sizeConstraint.Parent = mainFrame

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 16)
corner.Parent = mainFrame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 195, 30)
stroke.Thickness = 2.5
stroke.Parent = mainFrame

local grad = Instance.new("UIGradient")
grad.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(14, 30, 68)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 16, 36)),
})
grad.Rotation = 45
grad.Parent = mainFrame

-- Pasek nagłówka (Header)
local header = Instance.new("Frame")
header.Name = "Header"
header.Size = UDim2.new(1, 0, 0, 36)
header.BackgroundColor3 = Color3.fromRGB(8, 18, 40)
header.BorderSizePixel = 0
header.Parent = mainFrame

local hCorner = Instance.new("UICorner")
hCorner.CornerRadius = UDim.new(0, 16)
hCorner.Parent = header

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Size = UDim2.new(1, -50, 1, 0)
title.Position = UDim2.fromOffset(14, 0)
title.BackgroundTransparency = 1
title.Font = Enum.Font.FredokaOne
title.Text = "🦈 SCAMERINO ALERTINIO | CYBER-POMOCNIK"
title.TextColor3 = Color3.fromRGB(255, 220, 60)
title.TextSize = 16
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = header

local closeBtn = Instance.new("TextButton")
closeBtn.Name = "CloseBtn"
closeBtn.Size = UDim2.fromOffset(28, 28)
closeBtn.Position = UDim2.new(1, -34, 0.5, -14)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 45, 55)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.Font = Enum.Font.FredokaOne
closeBtn.TextSize = 16
closeBtn.AutoButtonColor = true
closeBtn.Parent = header

local cBtnCorner = Instance.new("UICorner")
cBtnCorner.CornerRadius = UDim.new(0, 8)
cBtnCorner.Parent = closeBtn

-- Lewy panel (Avatar i status)
local leftArea = Instance.new("Frame")
leftArea.Name = "LeftArea"
leftArea.Size = UDim2.new(0, 120, 1, -44)
leftArea.Position = UDim2.fromOffset(10, 38)
leftArea.BackgroundColor3 = Color3.fromRGB(15, 32, 70)
leftArea.BackgroundTransparency = 0.4
leftArea.BorderSizePixel = 0
leftArea.Parent = mainFrame

local lCorner = Instance.new("UICorner")
lCorner.CornerRadius = UDim.new(0, 12)
lCorner.Parent = leftArea

local avatarIcon = Instance.new("TextLabel")
avatarIcon.Size = UDim2.new(1, 0, 0, 60)
avatarIcon.Position = UDim2.fromOffset(0, 8)
avatarIcon.BackgroundTransparency = 1
avatarIcon.Font = Enum.Font.FredokaOne
avatarIcon.Text = "🦈"
avatarIcon.TextSize = 48
avatarIcon.Parent = leftArea

local badgeLabel = Instance.new("TextLabel")
badgeLabel.Name = "BadgeLabel"
badgeLabel.Size = UDim2.new(0.9, 0, 0, 36)
badgeLabel.Position = UDim2.new(0.05, 0, 1, -42)
badgeLabel.BackgroundColor3 = Color3.fromRGB(255, 180, 20)
badgeLabel.Font = Enum.Font.FredokaOne
badgeLabel.Text = "STATUS: CZUWA\n🛡️ BEZPIECZNY"
badgeLabel.TextColor3 = Color3.fromRGB(10, 20, 45)
badgeLabel.TextSize = 10
badgeLabel.Parent = leftArea

local bCorner = Instance.new("UICorner")
bCorner.CornerRadius = UDim.new(0, 8)
bCorner.Parent = badgeLabel

-- Prawy panel (Tekst wypowiedzi i przyciski)
local rightArea = Instance.new("Frame")
rightArea.Name = "RightArea"
rightArea.Size = UDim2.new(1, -145, 1, -44)
rightArea.Position = UDim2.fromOffset(136, 38)
rightArea.BackgroundTransparency = 1
rightArea.Parent = mainFrame

local dialogBox = Instance.new("TextLabel")
dialogBox.Name = "DialogBox"
dialogBox.Size = UDim2.new(1, 0, 1, -54)
dialogBox.Position = UDim2.new(0, 0, 0, 0)
dialogBox.BackgroundColor3 = Color3.fromRGB(15, 30, 65)
dialogBox.BackgroundTransparency = 0.3
dialogBox.TextColor3 = Color3.fromRGB(240, 245, 255)
dialogBox.Font = Enum.Font.GothamMedium
dialogBox.TextSize = 13
dialogBox.TextWrapped = true
dialogBox.TextXAlignment = Enum.TextXAlignment.Left
dialogBox.TextYAlignment = Enum.TextYAlignment.Top
dialogBox.Parent = rightArea

local dCorner = Instance.new("UICorner")
dCorner.CornerRadius = UDim.new(0, 10)
dCorner.Parent = dialogBox

local dPadding = Instance.new("UIPadding")
dPadding.PaddingLeft = UDim.new(0, 12)
dPadding.PaddingRight = UDim.new(0, 12)
dPadding.PaddingTop = UDim.new(0, 8)
dPadding.PaddingBottom = UDim.new(0, 8)
dPadding.Parent = dialogBox

local buttonContainer = Instance.new("Frame")
buttonContainer.Name = "ButtonContainer"
buttonContainer.Size = UDim2.new(1, 0, 0, 46)
buttonContainer.Position = UDim2.new(0, 0, 1, -48)
buttonContainer.BackgroundTransparency = 1
buttonContainer.Parent = rightArea

local listLayout = Instance.new("UIListLayout")
listLayout.FillDirection = Enum.FillDirection.Horizontal
listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
listLayout.Padding = UDim.new(0, 8)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = buttonContainer

-- Helper do tworzenia przycisków wyboru (min 44px touch target)
local function createChoiceBtn(order: number, text: string, callback: () -> (), color: Color3?): TextButton
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(155, 44) -- ergonomiczny cel dotykowy
	btn.BackgroundColor3 = color or Color3.fromRGB(22, 58, 128)
	btn.Font = Enum.Font.FredokaOne
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 12
	btn.TextWrapped = true
	btn.LayoutOrder = order
	btn.AutoButtonColor = true
	btn.Parent = buttonContainer

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = btn

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(255, 255, 255)
	btnStroke.Thickness = 1
	btnStroke.Transparency = 0.7
	btnStroke.Parent = btn

	btn.MouseButton1Click:Connect(callback)
	return btn
end

local function clearButtons()
	for _, c in ipairs(buttonContainer:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
end

-- Animacja Otwórz/Zamknij
local function openUI()
	mainFrame.Visible = true
	mainFrame.Position = UDim2.fromScale(0.5, 1.4)
	local tw = TweenService:Create(
		mainFrame,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0.5, 0, 1, -20) }
	)
	tw:Play()
end

local function closeUI()
	local tw = TweenService:Create(
		mainFrame,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = UDim2.fromScale(0.5, 1.4) }
	)
	tw:Play()
	tw.Completed:Connect(function()
		mainFrame.Visible = false
	end)
end

closeBtn.MouseButton1Click:Connect(closeUI)

-- Dialogi
local showMainMenu: () -> ()
local showPhishingInfo: () -> ()
local showScamSigns: () -> ()
local showRules: () -> ()
local showReportAdvice: () -> ()

showMainMenu = function()
	clearButtons()
	badgeLabel.Text = "STATUS: CZUWA\n🛡️ BEZPIECZNY"
	badgeLabel.BackgroundColor3 = Color3.fromRGB(255, 180, 20)

	dialogBox.Text =
		"Cześć! Jestem Scamerino Alertinio – Twój Cyber-Pomocnik! 🦈🛡️\nPilnuję, aby nikt w Roblox nie wyłudził Twojego hasła, konta ani Robuxów.\nO czym chcesz dowiedzieć się więcej?"

	createChoiceBtn(1, "🔍 Czym jest Phishing?", function()
		showPhishingInfo()
	end, Color3.fromRGB(30, 100, 200))

	createChoiceBtn(2, "⚠️ Czerwone flagi oszusta", function()
		showScamSigns()
	end, Color3.fromRGB(180, 110, 20))

	createChoiceBtn(3, "🛡️ 3 Złote Zasady", function()
		showRules()
	end)

	createChoiceBtn(4, "🚨 Podejrzany gracz w lobby!", function()
		showReportAdvice()
	end, Color3.fromRGB(200, 60, 60))

	createChoiceBtn(5, "👋 Do widzenia", function()
		closeUI()
	end, Color3.fromRGB(60, 70, 90))
end

showPhishingInfo = function()
	clearButtons()
	dialogBox.Text =
		"🎣 CZYM JEST PHISHING? To zarzucenie 'przynęty' (np. darmowe Robuxy, rzadki pet, fałszywy link). Gdy ktoś obiecuje Robuxy w zamian za hasło lub kod SMS, chce przejąć konto! Nigdy nie wpisuj hasła w odpowiedzi na taką ofertę."

	createChoiceBtn(1, "⚠️ Jak rozpoznać oszusta?", function()
		showScamSigns()
	end, Color3.fromRGB(180, 110, 20))

	createChoiceBtn(2, "🛡️ Złote zasady", function()
		showRules()
	end)

	createChoiceBtn(3, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

showScamSigns = function()
	clearButtons()
	dialogBox.Text =
		"⚠️ 3 CZERWONE FLAGI OSZUSTWA:\n1. 🎁 Zbyt piękne, by było prawdziwe ('Darmowe 10 000 Robuxów!')\n2. ⏱️ Presja czasu ('Tylko 60 sekund!')\n3. 🔑 Prośba o hasło lub kod SMS. Prawdziwy pracownik Roblox NIGDY o to nie pyta!"

	createChoiceBtn(1, "🚨 Ktoś na placu rozdaje Robuxy!", function()
		showReportAdvice()
	end, Color3.fromRGB(200, 60, 60))

	createChoiceBtn(2, "🛡️ Złote zasady", function()
		showRules()
	end)

	createChoiceBtn(3, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

showRules = function()
	clearButtons()
	dialogBox.Text =
		"🛡️ 3 ZŁOTE ZASADY BEZPIECZEŃSTWA:\n1. 🔑 NIGDY nie podawaj nikomu hasła ani kodów SMS.\n2. 👮 Roblox NIGDY nie prosi o hasło na czacie.\n3. ⏱️ Gdy ktoś każe działać 'szybko' – zwolnij i zapytaj rodzica lub opiekuna!"

	createChoiceBtn(1, "🔍 Czym jest Phishing?", function()
		showPhishingInfo()
	end, Color3.fromRGB(30, 100, 200))

	createChoiceBtn(2, "🚨 Podejrzany gracz w lobby", function()
		showReportAdvice()
	end, Color3.fromRGB(200, 60, 60))

	createChoiceBtn(3, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

showReportAdvice = function()
	clearButtons()
	dialogBox.Text =
		"👀 ZAUWAŻYŁEŚ GRACZA 'FreeRobux_Giver'? To klasyczny podstęp! Podejdź do niego [E] i sprawdź, czy rozpoznasz jego manipulacje. Pamiętaj: pod żadnym pozorem nie podawaj kodu – odrzuć ofertę!"

	createChoiceBtn(1, "🚶 Idę sprawdzić oszusta!", function()
		closeUI()
	end, Color3.fromRGB(40, 160, 60))

	createChoiceBtn(2, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

-- Nasłuchuj zdarzenia otwarcia od serwera
dialogueEvent.OnClientEvent:Connect(function(action: string)
	if action == "open" then
		showMainMenu()
		openUI()
	end
end)
