bCorner.Parent = badgeLabel

-- Prawy panel (Tekst wypowiedzi i przyciski)
local rightArea = Instance.new("Frame")
rightArea.Name = "RightArea"
rightArea.Size = UDim2.new(1, -136, 1, -44)
