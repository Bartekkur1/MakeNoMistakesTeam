dPadding.PaddingBottom = UDim.new(0, 8)
dPadding.Parent = dialogBox

local buttonContainer = Instance.new("Frame")
buttonContainer.Name = "ButtonContainer"
buttonContainer.Size = UDim2.new(1, 0, 0, 80)
buttonContainer.Position = UDim2.new(0, 0, 1, -80)
buttonContainer.BackgroundTransparency = 1
buttonContainer.Parent = rightArea

local gridLayout = Instance.new("UIGridLayout")
gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
gridLayout.CellPadding = UDim2.fromOffset(6, 6)
gridLayout.CellSize = UDim2.new(0.322, -4, 0, 36)
gridLayout.Parent = buttonContainer

local function configureButtonGrid(buttonCount: number)
	if buttonCount <= 2 then
		gridLayout.CellSize = UDim2.new(0.485, -4, 0, 36)
	else
		gridLayout.CellSize = UDim2.new(0.322, -4, 0, 36)
	end
end

-- Helper do tworzenia przycisków wyboru
local function createChoiceBtn(order: number, text: string, callback: () -> (), color: Color3?): TextButton
	local btn = Instance.new("TextButton")
	btn.BackgroundColor3 = color or Color3.fromRGB(22, 58, 128)
	btn.Font = Enum.Font.FredokaOne
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 12
	btn.TextWrapped = true
	btn.LayoutOrder = order
	btn.AutoButtonColor = true
	btn.Parent = buttonContainer

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = btn

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(255, 255, 255)
	btnStroke.Thickness = 1
	btnStroke.Transparency = 0.7
	btnStroke.Parent = btn

	local btnPad = Instance.new("UIPadding")
	btnPad.PaddingLeft = UDim.new(0, 4)
	btnPad.PaddingRight = UDim.new(0, 4)
	btnPad.PaddingTop = UDim.new(0, 2)
	btnPad.PaddingBottom = UDim.new(0, 2)
	btnPad.Parent = btn

	btn.MouseButton1Click:Connect(callback)
	return btn
end

local function clearButtons()
	for _, c in ipairs(buttonContainer:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
end

local INTERACTION_DISTANCE = 14
local BREAK_DISTANCE = 18
local isDialogueOpen = false

local function getScamerinoRoot(): BasePart?
	local scamerino = workspace:FindFirstChild("ScamerinoAlertinio")
	if not scamerino then
		return nil
	end
	local hrp = scamerino:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	local torso = scamerino:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	return nil
end

local function getPlayerRoot(): BasePart?
	local char = player.Character
	if not char then
		return nil
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local function getDistanceToScamerino(): number?
	local playerRoot = getPlayerRoot()
	local scamerinoRoot = getScamerinoRoot()
	if playerRoot and scamerinoRoot then
		return (playerRoot.Position - scamerinoRoot.Position).Magnitude
	end
	return nil
end

local function isMissionChatOpen(): boolean
	local mGui = playerGui:FindFirstChild("MissionGui")
	if mGui then
		local cFrame = mGui:FindFirstChild("SimulatedChatFrame") :: Frame?
		if cFrame and cFrame.Visible then
			return true
		end
	end
	return false
end

-- Animacja Otwórz/Zamknij
local function openUI()
	if isDialogueOpen or isMissionChatOpen() then
		return
	end
	isDialogueOpen = true
	remoteEvent:FireServer("startDialogue")
	mainFrame.Visible = true
	mainFrame.Position = UDim2.fromScale(0.5, 1.4)
	local tw = TweenService:Create(
		mainFrame,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0.5, 0, 1, -20) }
	)
	tw:Play()
end

local function closeUI()
	if not isDialogueOpen then
		return
	end
	isDialogueOpen = false
	remoteEvent:FireServer("endDialogue")
	local tw = TweenService:Create(
		mainFrame,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = UDim2.fromScale(0.5, 1.4) }
	)
	tw:Play()
	tw.Completed:Connect(function()
		if not isDialogueOpen then
			mainFrame.Visible = false
		end
	end)
end

closeBtn.MouseButton1Click:Connect(closeUI)

-- Dialogi
local showMainMenu: () -> ()
local showPhishingInfo: () -> ()
local showScamSigns: () -> ()
local showRules: () -> ()
local showReportingInfo: () -> ()

showMainMenu = function()
	clearButtons()
	configureButtonGrid(5)
	badgeLabel.Text = "STATUS: CZUWA\n🛡️ BEZPIECZNY"
	badgeLabel.BackgroundColor3 = Color3.fromRGB(255, 180, 20)

	dialogBox.Text =
		"Cześć! Jestem Scamerino Alertinio – Twój Cyber-Pomocnik! 🦈🛡️\nPilnuję cyberbezpieczeństwa na platformie. Pamiętaj: oszuści stosują sprytne sztuczki socjotechniczne, by wyłudzić hasła lub cenne przedmioty.\nO czym chcesz dowiedzieć się więcej?"

	createChoiceBtn(1, "🔍 Czym jest Phishing?", function()
		showPhishingInfo()
	end, Color3.fromRGB(30, 100, 200))

	createChoiceBtn(2, "⚠️ Czerwone flagi", function()
		showScamSigns()
	end, Color3.fromRGB(180, 110, 20))

	createChoiceBtn(3, "🛡️ 3 Złote Zasady", function()
		showRules()
	end)

	createChoiceBtn(4, "🚨 Jak reagować i zgłaszać?", function()
		showReportingInfo()
	end, Color3.fromRGB(200, 60, 60))

	createChoiceBtn(5, "👋 Do widzenia", function()
		closeUI()
	end, Color3.fromRGB(60, 70, 90))
end

showPhishingInfo = function()
	clearButtons()
	configureButtonGrid(3)
	dialogBox.Text =
		"🎣 CZYM JEST PHISHING?\nTo technika oszustwa polegająca na podszywaniu się pod zaufane osoby lub system gry. Oszust zarzuca 'haczyk' – obietnicę łatwych zysków (darmowa waluta, rzadkie przedmioty), aby uśpić Twoją czujność i zdobyć Twoje dane logowania."

	createChoiceBtn(1, "⚠️ Czerwone flagi", function()
		showScamSigns()
	end, Color3.fromRGB(180, 110, 20))

	createChoiceBtn(2, "🛡️ Złote zasady", function()
		showRules()
	end)

	createChoiceBtn(3, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

showScamSigns = function()
	clearButtons()
	configureButtonGrid(3)
	dialogBox.Text =
		"⚠️ 3 GŁÓWNE CZERWONE FLAGI OSZUSTWA:\n1. 🎁 Zbyt piękne, by było prawdziwe – nikt nie rozdaje waluty za darmo bez ukrytego podstępu.\n2. ⏱️ Sztuczna presja czasu ('Tylko teraz! Szybko, oferta zaraz wygaśnie!').\n3. 🔑 Pytania o poufne dane: hasła, maile, kody 2FA/SMS lub zewnętrzne linki."

	createChoiceBtn(1, "🚨 Jak reagować?", function()
		showReportingInfo()
	end, Color3.fromRGB(200, 60, 60))

	createChoiceBtn(2, "🛡️ Złote zasady", function()
		showRules()
	end)

	createChoiceBtn(3, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

showRules = function()
	clearButtons()
	configureButtonGrid(3)
	dialogBox.Text =
		"🛡️ 3 ZŁOTE ZASADY BEZPIECZEŃSTWA:\n1. 🔑 POUFNOŚĆ: Nigdy i nikomu nie zdradzaj hasła ani kodów weryfikacyjnych.\n2. 🛑 ZATRZYMAJ SIĘ: Gdy ktoś wywiera presję czasu, zwolnij i zapytaj kogoś zaufanego.\n3. 🌐 OFICJALNE FUNKCJE: Wszelkie transakcje wykonuj tylko przez oficjalne mechanizmy gry!"

	createChoiceBtn(1, "🔍 Czym jest Phishing?", function()
		showPhishingInfo()
	end, Color3.fromRGB(30, 100, 200))

	createChoiceBtn(2, "🚨 Jak zgłaszać?", function()
		showReportingInfo()
	end, Color3.fromRGB(200, 60, 60))

	createChoiceBtn(3, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

showReportingInfo = function()
	clearButtons()
	configureButtonGrid(2)
	dialogBox.Text =
		"🚨 JAK REAGOWAĆ I ZGŁASZAĆ ZAGROŻENIA?\n1. 🛑 Nie daj się zmanipulować i natychmiast przerwij kontakt z podejrzaną osobą.\n2. 🚩 Użyj funkcji 'Report Abuse' w menu Roblox (Esc), wybierając profil gracza i powód.\n3. 🚫 Zablokuj użytkownika (Block User), aby nie mógł Cię nękać.\n4. 👨‍👩‍👧 O każdym podejrzanym incydencie porozmawiaj z rodzicem lub zaufanym opiekunem."

	createChoiceBtn(1, "🛡️ Złote zasady", function()
		showRules()
	end)

	createChoiceBtn(2, "🔙 Wróć do menu", function()
		showMainMenu()
	end)
end

-- Nasłuchuj zdarzenia otwarcia/zamknięcia od serwera
remoteEvent.OnClientEvent:Connect(function(action: string)
	if action == "open" then
		showMainMenu()
		openUI()
	elseif action == "close" then
		closeUI()
	end
end)

-- Bezpośrednie uruchamianie dialogu klawiszem [E] w promieniu Scamerino (bez domyślnego infoboxa)
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	if input.KeyCode == Enum.KeyCode.E then
		local dist = getDistanceToScamerino()
		if dist and dist <= INTERACTION_DISTANCE then
			if not isDialogueOpen then
				showMainMenu()
				openUI()
			end
		end
	end
end)

-- Obsługa wyzwolenia ProximityPrompt
local function hookPrompt(prompt: Instance)
	if prompt:IsA("ProximityPrompt") and prompt.Name == "ChatPrompt" then
		prompt.Triggered:Connect(function(triggerPlayer)
			if triggerPlayer == player and not isDialogueOpen then
				showMainMenu()
				openUI()
			end
		end)
	end
end

ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
	if
		triggerPlayer == player
		and (
			prompt.Name == "ChatPrompt"
			or (prompt.Parent and prompt.Parent.Parent and prompt.Parent.Parent.Name == "ScamerinoAlertinio")
		)
	then
		if not isDialogueOpen then
			showMainMenu()
			openUI()
		end
	end
end)

local scamerino = workspace:FindFirstChild("ScamerinoAlertinio")
local torso = scamerino and scamerino:FindFirstChild("Torso")
local existingPrompt = torso and torso:FindFirstChild("ChatPrompt")
if existingPrompt then
	hookPrompt(existingPrompt)
end

workspace.DescendantAdded:Connect(function(desc)
	if desc.Name == "ChatPrompt" and desc:IsA("ProximityPrompt") then
		hookPrompt(desc)
	end
end)

-- Automatyczne zamykanie dialogu po odejściu na odległość > BREAK_DISTANCE lub rozpoczęciu misji
RunService.Heartbeat:Connect(function()
	if isDialogueOpen then
		if isMissionChatOpen() then
			closeUI()
			return
		end
		local dist = getDistanceToScamerino()
		if not dist or dist > BREAK_DISTANCE then
			closeUI()
		end
	end
end)

player.CharacterRemoving:Connect(function()
	if isDialogueOpen then
		closeUI()
	end
end)
