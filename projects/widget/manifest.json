{
  "manifest_version": 3,
  "name": "BezpiecznaAura – Scamerinio",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Pomocnik, który sprawdza tylko to, co mu pokażesz.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Pokaż Scamerinio", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "sw.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://bezpieczna-aura.pl/*", "http://localhost:3000/*"],
  "options_ui": { "page": "login.html", "open_in_tab": true }
}
